                                <?php
                                    $rank = $index + 1;
                                    $score = (float) $student->avg_score;
                                    $scoreClass = $score >= 8 ? 'high' : ($score >= 6.5 ? 'mid' : 'low');
                                    $initial = mb_strtoupper(mb_substr($student->name, 0, 1));
