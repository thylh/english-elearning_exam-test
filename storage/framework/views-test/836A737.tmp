                                $skill = strtolower($exam->skill ?? 'general');
                                $skillIcon = [
                                    'reading' => 'fa-book-open',
                                    'listening' => 'fa-headphones',
                                    'writing' => 'fa-pen-nib',
                                    'speaking' => 'fa-microphone',
                                ][$skill] ?? 'fa-clipboard-list';
